# -----------------------------------------------------------------------------
# Swift Converter Hub - environment variables
#
# Copy this file to .env.local and fill in the values:
#     cp .env.example .env.local
#
# Never commit .env.local or any file with real secrets.
# NEXT_PUBLIC_* values are built into the browser code at build time, so
# redeploy after changing one.
# -----------------------------------------------------------------------------

# --- Private (server only) ---------------------------------------------------

# Required. Sends contact-form emails through Resend (https://resend.com).
# The build stops with an error if this is missing.
RESEND_API_KEY=re_your_resend_api_key

# --- Public (visible in the browser) -----------------------------------------

# Optional. The site's https address, without a trailing slash. Leave it unset
# for production (defaults to https://www.swiftconverterhub.com); set it for
# preview or staging deploys so canonical URLs, the sitemap and share images
# point at the right host.
# NEXT_PUBLIC_SITE_URL=https://staging.swiftconverterhub.com

# Optional. Set to "false" to turn all AdSense ads off (handy in development).
# Any other value, or leaving it unset, keeps ads on.
NEXT_PUBLIC_ADS_ENABLED=true

# Optional. Set to "false" to turn Google Analytics and Microsoft Clarity off.
# Any other value, or leaving it unset, keeps analytics on (still subject to
# visitor consent).
NEXT_PUBLIC_ANALYTICS_ENABLED=true
